{
	"name": "review_website_nextjs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"postinstall": "prisma generate",
		"build": "prisma migrate deploy && NEXT_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) next build && npm run build_search_index",
		"start": "next start",
		"lint": "eslint && npm run lint:colors",
		"lint:colors": "node scripts/check-color-literals.mjs",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"prepare": "husky",
		"neon": "dotenv -e .env.neon -e .env --",
		"studio": "npx prisma studio",
		"prisma_generate": "npx prisma generate",
		"prisma_migrate": "npx prisma migrate dev",
		"compose": "docker compose up -d && docker compose up -d --wait db && npx prisma migrate deploy",
		"typecheck": "tsc --noEmit",
		"build_search_index": "tsx src/server/maintenance/build-search-index.ts",
		"cleanup_posters": "tsx src/server/maintenance/cron/cleanup-posters.ts",
		"cleanup_cropped_images": "tsx src/server/maintenance/cron/cleanup-cropped-images.ts",
		"enrich_db": "tsx src/server/maintenance/cron/enrich-db.ts",
		"purge_deleted_changelogs": "tsx src/server/maintenance/cron/purge-deleted-change-log.ts",
		"backup_database": "tsx src/server/maintenance/cron/backup-database.ts",
		"record_cron_failure": "tsx src/server/maintenance/cron/record-cron-failure.ts",
		"record_cron_success": "tsx src/server/maintenance/cron/record-cron-success.ts",
		"weekly_digest": "tsx src/server/maintenance/cron/send-weekly-digest.ts",
		"list_add_digest": "tsx src/server/maintenance/cron/send-list-add-digest.ts",
		"purge_non_notable_crew": "tsx src/server/maintenance/purge-non-notable-crew.ts",
		"add_movies_to_list": "tsx src/scripts/dev/add-movies-to-list.ts",
		"promote_admin": "tsx src/scripts/dev/promote-admin.ts",
		"clear_image_caches": "tsx src/scripts/dev/clear-image-caches.ts",
		"email_dev": "email dev --dir ./src/emails --port 3001"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@auth/prisma-adapter": "^2.11.3",
		"@aws-sdk/client-s3": "^3.1111.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.1.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"arktype": "^2.0.0",
		"bcryptjs": "^3.0.3",
		"diff": "^9.0.0",
		"fuse.js": "^7.5.0",
		"geist": "^1.7.2",
		"lucide-react": "^1.31.0",
		"next": "^16.3.0",
		"next-auth": "^5.0.0-beta.32",
		"nodemailer": "^8.0.11",
		"pg": "^8.22.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-easy-crop": "^6.2.3",
		"sharp": "^0.35.3",
		"zustand": "^5.0.14"
	},
	"overrides": {
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@react-email/ui": "^6.9.2",
		"@types/node": "^20",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-check-file": "^3.3.1",
		"husky": "^9.1.7",
		"mysql2": "^3.22.5",
		"prisma": "^7.8.0",
		"react-email": "^6.9.2",
		"sass": "^1.101.0",
		"tsx": "^4.23.12",
		"typescript": "^5"
	}
}
