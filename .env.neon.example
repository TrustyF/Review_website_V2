# Copy this to .env.neon (gitignored — never commit real credentials here)
# to point one-off commands at the deployed Neon database instead of local
# Postgres, without touching your normal .env. Run any script prefixed with
# `npm run neon --`, e.g.:
#
#   npm run neon -- npx prisma studio
#   npm run neon -- npx prisma migrate deploy
#   npm run neon -- npx tsx src/scripts/legacy/mysql-migration.ts
#
# Only the DB connection strings belong here — everything else (API keys,
# etc.) still comes from .env, since those don't differ between local dev
# and Neon. See package.json's "neon" script and prisma.config.ts.

# Neon's pooled connection string (the one the app itself/most commands use).
DATABASE_URL=

# Neon's unpooled/"direct" connection string — only prisma migrate/studio
# actually need this (see prisma.config.ts's own comment on why). Leave
# blank and DATABASE_URL is used for everything, pooled or not.
DIRECT_URL=
