# All three default to user/password/review_db in docker-compose.yml when
# left unset — inherently local/throwaway credentials (a fresh Postgres
# container with no external exposure), unlike AUTH_SECRET or any API key,
# so `docker compose up` works against a real local db with none of this
# filled in. Only need to set these to override that default (e.g. a
# stronger password, since this now holds real production data).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# The production DB (self-hosted on thinkguy, formerly Neon) and local dev
# both run plain, unpooled Postgres, so this one value covers everything
# that runs directly on the host: `npm run dev`, and — via
# docker-compose.yml's `app`/`maintenance` services' `build: network: host` —
# the Docker build step too (reaches `db`'s published port as
# `localhost:5432`, same as this value already does). No DIRECT_URL needed:
# that split only exists for a pooled connection string (e.g. Neon's old
# PgBouncer endpoint) — see prisma.config.ts's own comment. The *running*
# `app`/`maintenance` containers use a different, compose-network-facing
# value (`db:5432`) built inline in docker-compose.yml from
# POSTGRES_USER/PASSWORD/DB above, not from this var.
#
# Unlike POSTGRES_USER/PASSWORD/DB above, this one has no compose-level
# default — Compose's `secrets:` block (used to pass this into the Docker
# build) can only name an existing env var, not default a missing one, so
# `.env` needs to exist with this line for `docker compose build` to work at
# all (verified: with no .env file present, the build fails at `prisma
# generate` with `PrismaConfigEnvError: Cannot resolve environment variable:
# DATABASE_URL`). The value below already matches the POSTGRES_* defaults
# above, so copying this file to .env with zero edits is enough.
#
# To point one-off commands at the old Neon DB instead (e.g. during/after
# the migration off it) without touching this line, put Neon's
# DATABASE_URL/DIRECT_URL in .env.neon instead (see .env.neon.example) and
# prefix the command with `npm run neon --`.
DATABASE_URL="postgres://user:password@localhost:5432/review_db"

TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# Dev toggle, local testing only — set to 1 (in your own gitignored .env) and
# every source's cached by-id fetch (TMDB, MangaDex, IGDB, ComicVine, Google
# Books) caches its raw JSON under .fixtures/<source>/ (already gitignored),
# then replays it on later runs instead of hitting the network. Leave unset
# everywhere else, prod included. See src/server/lib/response-cache.ts.
CACHE_RESPONSES=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
COMIC_VINE_KEY=
GOOGLE_BOOKS_API_KEY=
ANTHROPIC_API_KEY=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed self-hosted, behind a reverse proxy/tunnel (e.g. Cloudflare
# Tunnel) — tells Auth.js to trust the proxied request's host instead of
# rejecting it. Not needed on Vercel. See docker-compose.yml's `app` service.
AUTH_TRUST_HOST=

# Token for the `cloudflared` service in docker-compose.yml, which tunnels
# review.arthursirjacobs.com to the `app` service without any inbound
# port-forwarding. Only needed self-hosted. Get this from the Cloudflare
# dashboard: Networking > Tunnels > select the tunnel > its connector command
# includes `--token <this value>`. The ingress rule (hostname -> service)
# itself lives on Cloudflare's side (configured via Networking > Tunnels >
# your tunnel > Routes), not in this repo.
CLOUDFLARE_TUNNEL_TOKEN=

# Base URL used for metadataBase / Open Graph image URLs (see
# src/app/layout.tsx). Defaults to http://localhost:3000 if unset — set this
# to the real public domain on any deployment other than local dev.
#
# docker-compose.yml's `app` service also reuses this value for AUTH_URL —
# Auth.js v5 needs its own canonical base URL explicitly self-hosted, since a
# tunneled request's Host header isn't reliably reaching it as the real
# public domain; without it, it falls back to the standalone server's own
# bind address and builds broken OAuth redirect_uris (observed as Google's
# "Error 400: invalid_request", redirect_uri pointing at 0.0.0.0:3000).
SITE_URL=

# Leave unset for normal local dev — cached posters/banners/crops/thumbnails
# just write under public/. The storage driver (see getImageStorage in
# src/server/storage/image-storage.ts) uses R2 only when IMAGE_STORAGE_DRIVER=r2
# is set explicitly — there's no more automatic Vercel detection, so this must
# be set on every deployment that should write to R2, Vercel included, as well
# as on the self-hosted deploy (docker-compose.yml's `app`/`maintenance`
# services). These R2_* vars need filling in wherever
# IMAGE_STORAGE_DRIVER=r2 is set (from the Cloudflare dashboard: R2 -> your
# bucket -> Settings, and R2 -> Manage API Tokens for the key pair).
IMAGE_STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Base URL objects are served from — either the bucket's r2.dev public URL
# or a custom domain mapped to it (R2 -> your bucket -> Settings -> Public
# access). No trailing slash.
R2_PUBLIC_URL=

# Separate, non-public R2 bucket the nightly DB backup cron job on thinkguy
# (src/server/maintenance/cron/backup-database.ts, invoked via docker-compose.yml's
# `maintenance` service — see thinkguy's crontab) uploads pg_dump output to.
# Only needed there — leave unset for plain local dev. Uses its own access
# key (scoped to only this bucket) rather than R2_ACCESS_KEY_ID/
# R2_SECRET_ACCESS_KEY, since those can read/write the public image bucket
# and a leaked backup credential shouldn't also grant that.
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET_NAME=
