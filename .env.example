POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL="postgres://user:password@localhost:5432/db_name"
# Only needed if DATABASE_URL is a pooled connection string (e.g. Neon's
# PgBouncer endpoint) — set this to the provider's unpooled/"direct"
# connection string instead, for `prisma migrate deploy` to use. Leave unset
# locally. See prisma.config.ts.
#
# To point one-off commands at the deployed Neon DB instead of local
# Postgres without touching these two lines, put Neon's DATABASE_URL/
# DIRECT_URL in .env.neon instead (see .env.neon.example) and prefix the
# command with `npm run neon --`.
DIRECT_URL=

TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
COMIC_VINE_KEY=
GOOGLE_BOOKS_API_KEY=
ANTHROPIC_API_KEY=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Leave all unset for normal local dev — the storage driver auto-detects:
# "local" (writes cached posters/banners/crops/thumbnails under public/)
# everywhere except on Vercel, where it switches to "r2" automatically
# (Vercel's own VERCEL=1 env var is the signal). Only set
# IMAGE_STORAGE_DRIVER explicitly to override that default — e.g. to test
# the r2 driver from your own machine, in which case also fill in the R2_*
# vars below from the Cloudflare dashboard (R2 -> your bucket -> Settings,
# and R2 -> Manage API Tokens for the key pair). See
# src/server/storage/image-storage.ts.
IMAGE_STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Base URL objects are served from — either the bucket's r2.dev public URL
# or a custom domain mapped to it (R2 -> your bucket -> Settings -> Public
# access). No trailing slash.
R2_PUBLIC_URL=

# Only needed to run IMAGE_STORAGE_DRIVER=vercel-blob (kept for rollback —
# see VercelBlobImageStorage in src/server/storage/image-storage.ts).
BLOB_READ_WRITE_TOKEN=
