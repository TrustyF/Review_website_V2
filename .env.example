POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL="postgres://user:password@localhost:5432/db_name"
# Only needed if DATABASE_URL is a pooled connection string (e.g. Neon's
# PgBouncer endpoint) — set this to the provider's unpooled/"direct"
# connection string instead, for `prisma migrate deploy` to use. Leave unset
# locally. See prisma.config.ts.
#
# To point one-off commands at the deployed Neon DB instead of local
# Postgres without touching these two lines, put Neon's DATABASE_URL/
# DIRECT_URL in .env.neon instead (see .env.neon.example) and prefix the
# command with `npm run neon --`.
DIRECT_URL=

TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
COMIC_VINE_KEY=
GOOGLE_BOOKS_API_KEY=
ANTHROPIC_API_KEY=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Leave both unset for normal local dev — the storage driver auto-detects:
# "local" (writes cached posters/banners/crops/thumbnails under public/)
# everywhere except on Vercel, where it switches to "vercel-blob"
# automatically (Vercel's own VERCEL=1 env var is the signal). Only set
# IMAGE_STORAGE_DRIVER explicitly to override that default — e.g. to test
# the blob driver from your own machine, in which case also paste in
# BLOB_READ_WRITE_TOKEN from the Vercel dashboard (Storage -> your Blob
# store -> .env.local tab). See src/server/storage/image-storage.ts.
IMAGE_STORAGE_DRIVER=
BLOB_READ_WRITE_TOKEN=
