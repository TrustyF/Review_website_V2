POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL="postgres://user:password@localhost:5432/db_name"
# Only needed if DATABASE_URL is a pooled connection string (e.g. Neon's
# PgBouncer endpoint) — set this to the provider's unpooled/"direct"
# connection string instead, for `prisma migrate deploy` to use. Leave unset
# locally. See prisma.config.ts.
#
# To point one-off commands at the deployed Neon DB instead of local
# Postgres without touching these two lines, put Neon's DATABASE_URL/
# DIRECT_URL in .env.neon instead (see .env.neon.example) and prefix the
# command with `npm run neon --`.
DIRECT_URL=

# Neon's pooled/unpooled connection strings, used only by docker-compose.yml's
# `app` service (both at image-build time, for `prisma migrate deploy`, and
# at runtime) — the self-hosted deploy always targets Neon, never the local
# `db` service. Kept as separate vars from DATABASE_URL/DIRECT_URL above so
# `.env` can hold both local-dev and Neon credentials at once with nothing to
# swap before building: `npm run dev` and the local `db` service use
# DATABASE_URL/DIRECT_URL, `docker compose build/up app` uses these. Same
# values as .env.neon (see .env.neon.example), which exists separately for
# one-off commands like `npm run neon -- npx prisma studio`.
NEON_DATABASE_URL=
NEON_DIRECT_URL=

TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# Dev toggle, local testing only — set to 1 (in your own gitignored .env) and
# every source's cached by-id fetch (TMDB, MangaDex, IGDB, ComicVine, Google
# Books) caches its raw JSON under .fixtures/<source>/ (already gitignored),
# then replays it on later runs instead of hitting the network. Leave unset
# everywhere else, prod included. See src/server/lib/response-cache.ts.
CACHE_RESPONSES=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
COMIC_VINE_KEY=
GOOGLE_BOOKS_API_KEY=
ANTHROPIC_API_KEY=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed self-hosted, behind a reverse proxy/tunnel (e.g. Cloudflare
# Tunnel) — tells Auth.js to trust the proxied request's host instead of
# rejecting it. Not needed on Vercel. See docker-compose.yml's `app` service.
AUTH_TRUST_HOST=

# Base URL used for metadataBase / Open Graph image URLs (see
# src/app/layout.tsx). Defaults to http://localhost:3000 if unset — set this
# to the real public domain on any deployment other than local dev.
SITE_URL=

# Leave unset for normal local dev — cached posters/banners/crops/thumbnails
# just write under public/. The storage driver (see getImageStorage in
# src/server/storage/image-storage.ts) uses R2 only when IMAGE_STORAGE_DRIVER=r2
# is set explicitly — there's no more automatic Vercel detection, so this must
# be set on every deployment that should write to R2, Vercel included, as well
# as on the self-hosted deploy (docker-compose.yml's `app` service) and the
# scheduled GitHub Actions workflows. These R2_* vars need filling in wherever
# IMAGE_STORAGE_DRIVER=r2 is set (from the Cloudflare dashboard: R2 -> your
# bucket -> Settings, and R2 -> Manage API Tokens for the key pair).
IMAGE_STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Base URL objects are served from — either the bucket's r2.dev public URL
# or a custom domain mapped to it (R2 -> your bucket -> Settings -> Public
# access). No trailing slash.
R2_PUBLIC_URL=

# Separate, non-public R2 bucket the nightly-ish DB backup workflow
# (.github/workflows/backup-database.yml, src/server/maintenance/
# backup-database.ts) uploads pg_dump output to. Only needed there — CI
# supplies these as repo secrets, so leave unset locally. Uses its own access
# key (scoped to only this bucket) rather than R2_ACCESS_KEY_ID/
# R2_SECRET_ACCESS_KEY, since those can read/write the public image bucket
# and a leaked backup credential shouldn't also grant that.
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET_NAME=
