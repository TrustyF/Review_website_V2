model Genre {
  id     Int       @id @default(autoincrement())
  name   String
  origin MediaType

  media MediaGenre[]

  @@unique([name, origin])
}

model MediaGenre {
  mediaId Int
  genreId Int

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
}
