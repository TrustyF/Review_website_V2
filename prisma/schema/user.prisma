enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  // Set once at signup (see auth-actions.ts), never editable afterward.
  name          String?
  // Editable display-name override — /account/settings writes this, never
  // `name`. Wherever a person's name is shown, prefer this over `name` when
  // set (see src/lib/display-name.ts). Not unique: nothing in this app
  // looks a user up by it or uses it as a handle (login is by email), it's
  // purely cosmetic.
  username      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Null for OAuth-only accounts — there's nothing to compare against in
  // Credentials' authorize(), so that provider just rejects the login.
  passwordHash String?

  role              UserRole @default(USER)
  preferredLanguage String   @default("en")
  // Weekly "what I rated and reviewed" recap email.
  newsletterOptIn   Boolean  @default(false)
  // Daily batch email summarizing recommendation-list additions — separate
  // from newsletterOptIn since it's a more personal/transactional email, not
  // a newsletter someone would want to opt out of independently.
  listAddEmailOptIn Boolean  @default(false)

  createDate DateTime @default(now())

  accounts            Account[]
  sessions            Session[]
  watchlistItems      WatchlistItem[]
  // Recommendation lists an admin has deposited into this account — see
  // List.targetUserId's own comment.
  recommendationLists List[]
  notifications       Notification[]
}

// Standard Auth.js Prisma adapter shape (Account/Session/VerificationToken)
// — required by the adapter contract regardless of session strategy. Account
// holds the Google OAuth link; Session/VerificationToken stay unused while
// Credentials forces session strategy "jwt" (see src/auth.ts), kept here so
// switching strategy later doesn't need a migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
