enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Null for OAuth-only accounts — there's nothing to compare against in
  // Credentials' authorize(), so that provider just rejects the login.
  passwordHash String?

  role              UserRole @default(USER)
  preferredLanguage String   @default("en")
  newsletterOptIn   Boolean  @default(false)

  createDate DateTime @default(now())

  accounts       Account[]
  sessions       Session[]
  watchlistItems WatchlistItem[]
}

// Standard Auth.js Prisma adapter shape (Account/Session/VerificationToken)
// — required by the adapter contract regardless of session strategy. Account
// holds the Google OAuth link; Session/VerificationToken stay unused while
// Credentials forces session strategy "jwt" (see src/auth.ts), kept here so
// switching strategy later doesn't need a migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
