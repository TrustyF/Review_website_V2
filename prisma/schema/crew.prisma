// Which API an externalId belongs to. Person/Company externalIds are only
// unique within their own source's id space — two sources can each hand out
// the same numeric id (or even the same string) for unrelated entities, so
// externalId alone is never a safe dedupe key on its own.
enum Source {
  TMDB
  MANGADEX
  IGDB
  COMIC_VINE
  GOOGLE_BOOKS
}

model Person {
  id         Int      @id @default(autoincrement())
  name       String
  externalId String
  source     Source
  credits    Credit[]

  // Populated from any cast or crew credit that TMDB itself hands back a
  // profile_path for (see syncMovieCreditsAndGenres/syncTvShowCreditsAndGenres)
  // — storing this is unconditional and cheap (just a string). Whether it's
  // ever actually downloaded/cached is a separate, read-time decision gated
  // by credited role (see person-photo-eligibility.ts's
  // PHOTO_ELIGIBLE_CREDIT_ROLES) — that's what keeps a photo from being
  // fetched for the long tail of crew jobs (Gaffer, Sound Editor, ...)
  // nobody's realistically going to look up, without needing this field to
  // stay blank for them forever.
  photoPath String?

  @@unique([externalId, source])
}

model Company {
  id         Int    @id @default(autoincrement())
  name       String
  externalId String
  source     Source

  type          String // e.g. "studio", "production_company", "network"
  logoPath      String?
  countryId     Int?
  originCountry Country? @relation(fields: [countryId], references: [id])
  credits       Credit[]

  @@unique([externalId, source])
}

model Role {
  id     Int       @id @default(autoincrement())
  name   String // "Director", "Writer", "Studio", "Producer", etc.
  origin MediaType

  credits Credit[]

  @@unique([name, origin])
}

model Credit {
  id Int @id @default(autoincrement())

  mediaId Int
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  personId Int?
  person   Person? @relation(fields: [personId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  order     Int?
  character String?

  // Postgres doesn't auto-index relation scalar columns the way MySQL does —
  // every one of these gets filtered on somewhere hot: mediaId on every
  // media detail page load and every re-ingest's deleteMany, personId/
  // companyId on every credit page load, roleId whenever a role is matched
  // by name during ingest/query.
  @@index([mediaId])
  @@index([personId])
  @@index([companyId])
  @@index([roleId])
}
