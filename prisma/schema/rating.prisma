model Review {
  id Int @id @default(autoincrement())

  mediaId Int   @unique
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  rating        Float?
  // Set once, at creation only (see saveReview's `create` branch) — the
  // rating actually given at the time, immune to `rating` itself changing
  // later. Deliberately its own stored column rather than derived from
  // MediaChangeLog's earliest "rating" row: that log is deletable
  // (deleteChangeLogEntry / purge-deleted-change-log.ts), so a derivation
  // depending on it surviving could silently go stale if it didn't.
  initialRating Float?
  liked         Boolean @default(false)
  // null and 0 are equivalent — both mean "no difficulty notch" (see
  // MediaPoster's own difficulty === 1 || difficulty === 2 check); 1 is
  // medium, 2 is hard.
  difficulty    Int?

  body String?

  // Curated by an admin via the homepage's "manage featured reviews" modal
  // (featured-manager-modal.tsx) — takes priority over plain recency in
  // FeaturedReview's hero (see app/page.tsx's getFeaturedReviewItems). No
  // expiry field on purpose: the modal already makes un-featuring a
  // one-click action, so a separate auto-expiry would just be a second way
  // to do the same thing.
  featured Boolean @default(false)

  // Set once, the first time body actually goes from unset to set — see
  // saveReview. "Watched on" reads createDate below instead (a rating is
  // required to save at all now, so createDate can never predate one) —
  // this is specifically "when did the review text itself first exist",
  // which can land well after the rating did. Surfaced in the changelog as
  // a synthesized "Reviewed on" entry (see change-log-list.tsx), same as
  // createDate's "Watched on" — neither is a real MediaChangeLog row.
  // "Rewatched on" is the one milestone that's still a real, repeatable row
  // — see logRewatch.
  reviewDate DateTime?

  createDate DateTime  @default(now())
  updateDate DateTime?
}

enum RatingSource {
  IMDB
  LETTERBOXD
  ROTTEN_TOMATOES
  METACRITIC
}
