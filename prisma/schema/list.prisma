model List {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  thumbnail   String?
  createDate  DateTime @default(now())
  updateDate  DateTime @updatedAt

  items ListItem[]
}

model ListItem {
  listId  Int
  mediaId Int

  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([listId, mediaId])
  // @@id([listId, mediaId]) only indexes that pair with listId leading —
  // no current query looks up by mediaId alone, but media/[id]/page.tsx
  // already computes "which lists contain this media" from a List-side
  // query, one small step from wanting this the other way around too.
  @@index([mediaId])
}
