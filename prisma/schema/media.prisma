model Media {
  id Int @id @default(autoincrement())

  title          String
  alternateTitle String?
  type           MediaType
  overview       String?
  status         MediaStatus @default(RELEASED)
  publicRating   Float?
  posterPath     String?
  bannerPath     String?
  // Vertical object-position (0 = top, 100 = bottom) for the banner's
  // object-fit: cover crop — the display box is almost always shorter than
  // the source image, so a fixed center crop doesn't always frame the
  // interesting part. See banner-edit-trigger.tsx's framing slider.
  bannerFocusY   Int     @default(50)

  isDeleted Boolean @default(false)

  externalId String?
  directLink String?
  sourceUrl  String?

  countryId     Int?
  originCountry Country? @relation(fields: [countryId], references: [id])

  releaseDate DateTime?
  createDate  DateTime? @default(now())
  updateDate  DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  lastEnrichedAt   DateTime?

  mediaGenres MediaGenre[]
  listItems   ListItem[]

  tvShow TvShow?
  movie  Movie?
  manga  Manga?
  comic  Comic?
  game   Game?

  review  Review?
  credits Credit[]

  changeLog MediaChangeLog[]

  // Multiple manual entries (externalId null) never collide here — Postgres
  // treats each NULL as distinct — this only stops the same provider item
  // from being imported into the same type twice.
  @@unique([externalId, type])
  // Backs every per-type list page's `where: { type, enrichmentStatus }`
  // (+ recency sort via releaseDate) and the home feed's same filter.
  @@index([type, enrichmentStatus, releaseDate])
  // Backs dbPublic's isDeleted: false merge (see src/server/db/client.ts),
  // which rides along on almost every public-facing Media query, plus the
  // plain enrichmentStatus-only scans in the list/global search actions.
  @@index([enrichmentStatus, isDeleted])
}

enum MediaType {
  MOVIE
  SHORT
  TVSHOW
  MANGA
  COMIC
  GAME
}

enum EnrichmentStatus {
  PENDING
  DONE
}

enum MediaStatus {
  ANNOUNCED // minimal info, not released
  UPCOMING // confirmed, has release date
  RELEASED
  ONGOING // for TV or Manga
  COMPLETED // for TV or Manga
}

model Movie {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  runtime          Int
  budget           Float?
  revenue          Float?
  tagline          String?
  imdbID           String?
  originalLanguage String?
}

model TvShow {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  episodeCount Int?
  seasonCount  Int?
  network      String?
}

model Manga {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  chapterCount Int?
  volumeCount  Int?
}

model Comic {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  chapterCount Int?
  volumeCount  Int?
}

model Game {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  platform  String?
}
