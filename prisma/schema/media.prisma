model Media {
  id Int @id @default(autoincrement())

  title          String
  alternateTitle String?
  type           MediaType
  overview       String?
  status         MediaStatus @default(RELEASED)
  publicRating   Float?
  posterPath     String?

  isDeleted Boolean @default(false)

  externalId String
  directLink String?

  countryId     Int?
  originCountry Country? @relation(fields: [countryId], references: [id])

  releaseDate DateTime?
  createDate  DateTime? @default(now())
  updateDate  DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  lastEnrichedAt   DateTime?

  mediaGenres MediaGenre[]

  tvShow TvShow?
  movie  Movie?
  manga  Manga?
  comic  Comic?
  game   Game?

  review  Review?
  credits Credit[]
}

enum MediaType {
  MOVIE
  SHORT
  TVSHOW
  MANGA
  COMIC
  GAME
}

enum EnrichmentStatus {
  PENDING
  DONE
}

enum MediaStatus {
  ANNOUNCED // minimal info, not released
  UPCOMING // confirmed, has release date
  RELEASED
  ONGOING // for TV or Manga
  COMPLETED // for TV or Manga
}

model Movie {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  runtime          Int
  budget           Int?
  revenue          Int?
  tagline          String?
  imdbID           String?
  originalLanguage String?
}

model TvShow {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  episodeCount Int?
  seasonCount  Int?
  network      String?
}

model Manga {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  chapterCount Int?
  volumeCount  Int?
  author       String?
  publisher    String?
}

model Comic {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  chapterCount Int?
  volumeCount  Int?
  author       String?
  publisher    String?
}

model Game {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  platform  String?
  developer String?
  publisher String?
}
