model Media {
  id Int @id @default(autoincrement())

  title          String
  alternateTitle String?
  type           MediaType
  overview       String?
  status         MediaStatus @default(RELEASED)
  // Manually toggled in the media editor (see media-editor-modal.tsx) — not
  // sourced from any provider's own adult/mature flag yet. Not wired into
  // media-filter.ts yet either; the field exists first so it can be set on
  // existing media ahead of that.
  isAdult        Boolean     @default(false)
  publicRating   Float?
  posterPath     String?
  bannerPath     String?
  // Vertical object-position (0 = top, 100 = bottom) for the banner's
  // object-fit: cover crop — the display box is almost always shorter than
  // the source image, so a fixed center crop doesn't always frame the
  // interesting part. See banner-edit-trigger.tsx's framing slider.
  bannerFocusY   Int         @default(50)

  isDeleted Boolean @default(false)

  externalId String?
  directLink String?
  sourceUrl  String?

  countryId     Int?
  originCountry Country? @relation(fields: [countryId], references: [id])

  releaseDate DateTime?
  createDate  DateTime? @default(now())
  updateDate  DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  lastEnrichedAt   DateTime?

  mediaGenres    MediaGenre[]
  listItems      ListItem[]
  watchlistItems WatchlistItem[]
  notifications  Notification[]

  tvShow TvShow?
  movie  Movie?
  manga  Manga?
  comic  Comic?
  game   Game?
  book   Book?

  review  Review?
  credits Credit[]

  changeLog MediaChangeLog[]

  // Multiple manual entries (externalId null) never collide here — Postgres
  // treats each NULL as distinct — this only stops the same provider item
  // from being imported into the same type twice.
  @@unique([externalId, type])
  // Backs every per-type list page's `where: { type, enrichmentStatus }`
  // (+ recency sort via releaseDate) and the home feed's same filter.
  @@index([type, enrichmentStatus, releaseDate])
  // Backs dbPublic's isDeleted: false merge (see src/server/db/client.ts),
  // which rides along on almost every public-facing Media query, plus the
  // plain enrichmentStatus-only scans in the list/global search actions.
  @@index([enrichmentStatus, isDeleted])
}

enum MediaType {
  MOVIE
  SHORT
  TVSHOW
  MANGA
  COMIC
  GAME
  BOOK
}

enum EnrichmentStatus {
  PENDING
  DONE
}

enum MediaStatus {
  ANNOUNCED // minimal info, not released
  UPCOMING // confirmed, has release date
  RELEASED
  ONGOING // for TV or Manga
  COMPLETED // for TV or Manga
}

model Movie {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  runtime          Int?
  budget           Float?
  revenue          Float?
  tagline          String?
  imdbID           String?
  originalLanguage String?
  // TMDB's own rolling popularity score — recomputed roughly daily from view
  // counts, vote activity, watchlist/favorite adds, and release recency, not
  // a stable fact like runtime/budget. Refreshed on every re-enrich the same
  // way publicRating is (see movie.ts), not just filled in once.
  popularity       Float?
}

model TvShow {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  episodeCount Int?
  seasonCount  Int?
  network      String?
  // Same TMDB rolling score as Movie.popularity — see that field's own
  // comment.
  popularity   Float?
}

model Manga {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  chapterCount Int?
  volumeCount  Int?
}

model Comic {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  chapterCount Int?
  volumeCount  Int?
}

model Game {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  platform String?
}

model Book {
  mediaID Int   @id
  media   Media @relation(fields: [mediaID], references: [id], onDelete: Cascade)

  pageCount Int?
  isbn      String?
}
