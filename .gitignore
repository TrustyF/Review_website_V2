# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.neon

# vercel
.vercel

# Response fixtures written by CACHE_RESPONSES=1, one subdir per source (see
# src/server/lib/response-cache.ts)
/.fixtures/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# claude code local settings
.claude/

# Next.js compiles .sass files directly — these are stale IDE file-watcher output
/src/app/styles/globals.css
/src/app/styles/globals.css.map
**/*.module.css
**/*.module.css.map
# Everything under public/ is generated/cached (posters, banners, cropped
# temp files, ...) except the hand-authored assets in public/ui and
# public/avatars (avatar-catalog.ts's picker options) — ignore the whole
# tree and carve those directories back out, rather than listing each
# generated subfolder individually (a new cache dir would otherwise need
# its own line added here to stay untracked).
/public/*
!/public/ui
!/public/avatars
/.idea/
/CLAUDE.md
/AGENTS.md
/backups/
